@page
@model MyNUnitWeb.Pages.IndexModel
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using MyNUnit
@using MyNUnitWeb.Pages
@{
    ViewData["Title"] = "Test Run";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyNUnitWeb</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container">
    <h2 class="mb-4">Загрузка DLL файлов</h2>

    <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" class="mb-4">
        <div class="mb-3">
            <label for="Files" class="form-label">Выберите файлы (.dll):</label>
            <input type="file" class="form-control" name="Files" id="Files" multiple />
        </div>
        <button type="submit" class="btn btn-primary">Загрузить</button>
    </form>

    <form method="post" enctype="multipart/form-data" asp-page-handler="Delete" class="mb-4">
        <button type="submit" class="btn btn-danger">Очистить</button>
    </form>

    <h3 class="mt-4">Загруженные файлы</h3>

    @if (Model.Upload.UploadFiles.Any())
    {
        <ul class="list-group">
            @foreach (var file in Model.Upload.UploadFiles)
            {
                <li class="list-group-item">@file</li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">Нет загруженных файлов.</p>
    }

    <h2 class="mt-5">Запуск тестов</h2>

    <div class="row justify-content-start">
        <div class="col-auto">
            <form method="post" asp-page-handler="RunTests" class="mb-4">
                <button type="submit" class="btn btn-success">Начать тестирование</button>
            </form>
        </div>

        <div class="col-auto">
            <a class="btn btn-primary" asp-page="TestHistory">История</a>
        </div>

    </div>

    @if (Model.TestRun != null && Model.TestRun.TestClasses.Any())
    {
        <h3 class="mt-4">Результаты тестирования:</h3>
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Название класса</th>
                        <th>Название теста</th>
                        <th>Статус</th>
                        <th>Время выполнения (мс)</th>
                        <th>Сообщение об ошибке</th>
                        <th>Причина игнорирования</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var testClass in Model.TestRun.TestClasses)
                    {
                        foreach (var testDetail in testClass.TestDetails)
                        {
                            <tr>
                                <td>@testClass.Name</td>
                                <td>@testDetail.TestName</td>
                                <td>
                                    @switch (testDetail.Status)
                                    {
                                        case "Passed":
                                            <span class="badge bg-success">Успешно</span>
                                            break;
                                        case "Failed":
                                            <span class="badge bg-danger">Провалено</span>
                                            break;
                                        default:
                                            <span class="badge bg-warning text-dark">Игнорировано</span>
                                            break;
                                    }
                                </td>
                                <td>@testDetail.ExecutionTime</td>
                                <td>@testDetail.ErrorMessage</td>
                                <td>@testDetail.IgnoreMessage</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text">Нет результатов тестирования.</p>
    }
</div>