@page
@model MyNUnitWeb.Pages.TestHistory
@{
    ViewData["Title"] = "Test History";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyNUnitWeb</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<div class="container mt-5">
    <h1>Test Run History</h1>

    <a href="/" class="btn btn-primary mb-3">Return to Test Run</a>

    <div class="accordion" id="testHistoryAccordion">
        @foreach (var run in Model.TestRuns)
        {
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-@run.Id">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#collapse-@run.Id" aria-expanded="false" aria-controls="collapse-@run.Id">
                        Test Run #@run.Id - Total: @run.TotalTests, Passed: @run.PassedTests, Failed: @run.FailedTests,
                        Ignored: @run.IgnoredTests
                    </button>
                </h2>
                <div id="collapse-@run.Id" class="accordion-collapse collapse" aria-labelledby="heading-@run.Id"
                     data-bs-parent="#testHistoryAccordion">
                    <div class="accordion-body">
                        <ul class="list-group">
                            @foreach (var testClass in run.TestClasses)
                            {
                                <li class="list-group-item">
                                    <h5>@testClass.Name</h5>
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Test Name</th>
                                                <th>Status</th>
                                                <th>Execution Time (ms)</th>
                                                <th>Details</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var detail in testClass.TestDetails)
                                            {
                                                <tr>
                                                    <td>@detail.TestName</td>
                                                    <td>
                                                        @switch (detail.Status)
                                                        {
                                                            case "Passed":
                                                                <span class="badge bg-success">@detail.Status</span>
                                                                break;
                                                            case "Failed":
                                                                <span class="badge bg-danger">@detail.Status</span>
                                                                break;
                                                            default:
                                                                <span class="badge bg-warning">@detail.Status</span>
                                                                break;
                                                        }
                                                    </td>
                                                    <td>@detail.ExecutionTime</td>
                                                    <td>
                                                        @if (detail.Status == "Failed")
                                                        {
                                                            <span class="text-danger">Error: @detail.ErrorMessage</span>
                                                        }
                                                        else if (detail.Status == "Ignored")
                                                        {
                                                            <span class="text-warning">Ignored: @detail.IgnoreMessage</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
